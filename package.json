{
  "name": "claude-intercom",
  "version": "1.0.0",
  "description": "Claude-to-Claude relay via MCP — drive a real claude.ai conversation from another Claude instance.",
  "main": "main.js",
  "author": "SpookyPirate",
  "license": "MIT",
  "homepage": "https://github.com/SpookyPirate/claude-intercom",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpookyPirate/claude-intercom.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build:bridge": "esbuild mcp-bridge.js --bundle --platform=node --target=node20 --outfile=dist-bridge/bundle.cjs && pkg dist-bridge/bundle.cjs --targets node22-win-x64 --output dist-bridge/claude-intercom-bridge.exe",
    "build:app": "electron-packager . \"Claude Intercom\" --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/dist --ignore=^/dist-bridge --ignore=^/docs --ignore=\"\\.md$\" --extra-resource=dist-bridge/claude-intercom-bridge.exe --icon=build/icon.ico",
    "build:zip": "powershell -NoProfile -Command \"Compress-Archive -Path 'dist/Claude Intercom-win32-x64/*' -DestinationPath 'dist/claude-intercom-1.0.0-win-x64.zip' -Force\"",
    "build": "npm run build:bridge && npm run build:app && npm run build:zip"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@yao-pkg/pkg": "^6.20.0",
    "electron": "^31.0.0",
    "esbuild": "^0.28.0"
  },
  "pkg": {
    "scripts": "mcp-bridge.js",
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist-bridge"
  }
}
